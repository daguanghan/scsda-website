---
import BaseLayout from "../layouts/BaseLayout.astro";
import { caseStudies, engineeringMonitoringDemonstrators } from "@data/research";
---

<BaseLayout
  title="Selected Projects"
  description="Selected public-facing SCSDA project summaries in BIM, digital twins, reality capture, MEMS sensing, smart infrastructure, and sustainable urban systems."
>
  <section class="section">
    <div class="shell section-heading">
      <div>
        <p class="eyebrow">Projects and Case Studies</p>
        <h2>Public summaries of platform construction and applied research.</h2>
      </div>
      <p>
        Research-centre development, engineering validation, training, digital construction and sensing. Taken together they show that SCSDA's
        work is not presented as isolated consultancy, but as applied research
        activity that connects research agendas, demonstrators, technical
        systems, partner-facing collaboration, and education-oriented
        knowledge exchange.
      </p>
    </div>
    <div class="shell theme-grid">
      {caseStudies.map((item) => (
        <article class="theme-card">
          <span class="category">{item.category}</span>
          <h3>{item.title}</h3>
          <p>{item.summary}</p>
          <ul class="clean-list">
            {item.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section surface">
    <div class="shell section-heading">
      <div>
        <p class="eyebrow">Product and Prototype Material</p>
        <h2>Applied monitoring, sensing, and environmental demonstrators.</h2>
      </div>
      <p>
        Public product-brochure visuals preserved from SCSDA-related materials
        show applied work around sensing, site monitoring, infrastructure
        safety, VOCs sensing, and indoor-environment data. The examples below
        are presented as research and engineering demonstrators. Their value is
        that they show a pathway from technical concept to field context:
        sensing hardware, monitoring architecture, platform interfaces, and
        engineering deployment scenarios are described together for
        international academic and industry audiences.
      </p>
    </div>
    <div class="shell product-grid">
      {engineeringMonitoringDemonstrators.map((item) => (
        <article class="case-card product-card">
          <img src={item.image} alt={`${item.title} visual material`} />
          <div class="case-body">
            <span class="category">{item.category}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell section-heading">
      <div>
        <p class="eyebrow">Fieldwork</p>
        <h2>Engineering work in the field.</h2>
      </div>
      <p>
        Applied research at SCSDA is validated in the field: scanning,
        instrumentation and inspection on live infrastructure, and materials
        trials on operating roads.
      </p>
    </div>
    <div class="shell highlight-grid">
      <article class="case-card">
        <img
          src="/images/field-engineering-work.jpg"
          alt="Engineers carrying out laser scanning, instrumentation and inspection work on infrastructure sites"
          width="1080"
          height="683"
          loading="lazy"
        />
        <div class="case-body">
          <span class="category">Site validation</span>
          <h3>Scanning, instrumentation and inspection</h3>
          <p>Field teams combine terrestrial laser scanning, sensor installation and structural inspection so that research methods are tested against real assets rather than laboratory mock-ups alone.</p>
        </div>
      </article>
      <article class="case-card">
        <img
          src="/images/recycled-materials-pilot.jpg"
          alt="Recycled concrete pilot works on an operating expressway section"
          width="1268"
          height="661"
          loading="lazy"
        />
        <div class="case-body">
          <span class="category">Sustainable construction</span>
          <h3>Recycled-materials pilot on an expressway</h3>
          <p>Construction waste from maintenance excavation was processed and re-used on site in a recycled-materials pilot, drawing on European construction-waste recycling research.</p>
        </div>
      </article>
    </div>
  </section>

  <section class="section surface">
    <div class="shell article narrow">
      <p class="eyebrow">What These Pages Cover</p>
      <h2>Research questions, methods, and what they produced.</h2>
      <p>
        Applied research questions, platform capabilities, technical workflows and public records of research development across digital construction and smart infrastructure.
      </p>
    </div>
  </section>
</BaseLayout>
